# =============================================================================
# Loki — Per-instance configuration
# =============================================================================
# Copy this file as `.env` and uncomment ONLY the variables you want to override.
# Values shown are the defaults applied by the compose when the variable is
# commented out or absent.
#
# Each Loki running on the same host should have its own .env (ideally in
# separate directories: loki-system-a/, loki-system-b/, etc).
# =============================================================================

# === Version ================================================================
# Exact image tag of the official Loki image. Do NOT use `latest` in production.
# See: https://github.com/grafana/loki/releases
#LOKI_VERSION=3.7.1

# === Instance identification ================================================
# Unique system name. Used as suffix for container_name and, by convention,
# as the bucket name in MinIO when using s3 backend.
#LOKI_INSTANCE_NAME=default

# === Deployment mode ========================================================
# Selects which services `docker compose up` brings up. Valid values:
# - monolithic: 1 container with all components (recommended).
# - scalable:   3 containers (read/write/backend). Requires LOKI_STORAGE_BACKEND=s3.
# Native Compose variable — no need to pass --profile on the CLI.
# NOTE: this is the only variable that MUST stay uncommented. Docker Compose
# does not support a fallback default for COMPOSE_PROFILES from inside the
# compose file, so without it no service is selected.
COMPOSE_PROFILES=monolithic

# === Persistence (host) =====================================================
# Host directory where Loki persists WAL, TSDB index, compactor working dir
# and (only when LOKI_STORAGE_BACKEND=filesystem) chunks.
#LOKI_DATA_DIR=./data/loki

# === Resources ==============================================================
# Reservations: minimum guaranteed by Docker (kept idle but available).
# Limits: hard ceiling — if Loki needs more, it gets OOM-killed.
#LOKI_CPU_RESERVATION=0.25
#LOKI_MEMORY_RESERVATION=256M
#LOKI_CPU_LIMIT=1.0
#LOKI_MEMORY_LIMIT=1G

# === Network ports ==========================================================
# Ports published to the host. Change them if there's a conflict with another
# Loki on the same server (system-a uses 3100, system-b uses 3101, etc).
#LOKI_HTTP_PORT=3100
#LOKI_GRPC_PORT=9095

# === Retention and ingestion limits =========================================
#LOKI_RETENTION_PERIOD=2160h           # 90 days (3 months)
#LOKI_INGESTION_RATE_MB=4              # MB/s per tenant
#LOKI_INGESTION_BURST_MB=6             # MB of burst allowed
#LOKI_MAX_QUERY_LENGTH=2161h           # slightly more than retention

# === Multi-tenant (X-Scope-OrgID) ===========================================
# - false: Loki accepts requests without the header. Everything goes to the
#          `fake` tenant.
# - true:  Loki requires X-Scope-OrgID on each request (Promtail/Alloy sends it).
# This is NOT network authentication; for that, use a reverse proxy with auth.
#LOKI_AUTH_ENABLED=false

# === Storage backend ========================================================
# - filesystem: chunks in LOKI_DATA_DIR. No external deps. Single-node only.
# - s3:         chunks in external MinIO/S3. Required for scalable mode.
#LOKI_STORAGE_BACKEND=filesystem

# === MinIO / S3 (only when LOKI_STORAGE_BACKEND=s3) =========================
# The bucket must exist before starting Loki. Create a service account in
# MinIO console with read/write policy on that bucket.

# MinIO endpoint. Use https when going through a reverse proxy with TLS.
#S3_ENDPOINT=

# Bucket dedicated to this system. Convention: loki-${LOKI_INSTANCE_NAME}.
#S3_BUCKET=

# Service account credentials.
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# Region is required by the AWS SDK even though MinIO ignores it.
#S3_REGION=us-east-1

# Path-style URLs (bucket in path, not in subdomain). MinIO requires this.
#S3_FORCE_PATH_STYLE=true

# Set to true ONLY if S3_ENDPOINT is http:// (no TLS). Always false in prod.
#S3_INSECURE=false

# === Shared network =========================================================
# External network (must already exist) where Loki attaches to talk to MinIO,
# Grafana, or other services. Create with:
#   docker network create --driver bridge loki_router
# MinIO must also be attached to this network.
#LOKI_ROUTER_NETWORK=loki_router

# === Grafana Labs analytics =================================================
# false = no usage/diagnostics data is sent to Grafana Labs.
#LOKI_ANALYTICS_REPORTING=false

# =============================================================================
# Grafana (optional)
# =============================================================================
# To enable Grafana alongside Loki, uncomment COMPOSE_FILE below. This stacks
# the base compose with the Grafana override file.
# When enabled, Grafana auto-provisions:
#   - A Loki datasource pointing at this instance, with the X-Scope-OrgID
#     header set to ${LOKI_TENANT}.
#   - A "Loki — Overview" dashboard with datasource picker, job/level filters
#     and a free-text search.
#COMPOSE_FILE=docker-compose.yml:docker-compose.grafana.yml

# === Grafana version and credentials ========================================
#GRAFANA_VERSION=13.0.1
#GRAFANA_ADMIN_USER=admin
#GRAFANA_ADMIN_PASSWORD=admin
#GRAFANA_LOG_LEVEL=warn

# === Grafana network ========================================================
# Bound to loopback by default — change to 0.0.0.0:3000 to expose on LAN
# (or to a specific host IP, e.g. 10.0.0.5:3000).
#GRAFANA_PORT=127.0.0.1:3000

# URL Grafana uses to reach Loki (in the shared docker network).
# Default works when both run from this compose stack.
#GRAFANA_LOKI_URL=http://loki:3100

# === Grafana persistence ====================================================
# Host directory for Grafana SQLite db, plugins, etc.
#GRAFANA_DATA_DIR=./data/grafana

# === Grafana resources ======================================================
#GRAFANA_CPU_RESERVATION=0.1
#GRAFANA_MEMORY_RESERVATION=128M
#GRAFANA_CPU_LIMIT=1.0
#GRAFANA_MEMORY_LIMIT=512M

# =============================================================================
# Grafana OIDC / Keycloak SSO (optional)
# =============================================================================
# To enable Single Sign-On against Keycloak (or any OIDC provider), append the
# OIDC override file to COMPOSE_FILE, e.g.:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.grafana.yml:docker-compose.grafana-oidc.yml
#
# Pre-requisite: create a client in Keycloak with these settings:
#   Client ID:          (your choice, e.g. grafana-loki-qa)
#   Client type:        OpenID Connect
#   Client auth:        On (Confidential — generates a Client Secret)
#   Standard flow:      Enabled
#   Direct access:      Disabled
#   Valid redirect URI: <GRAFANA_ROOT_URL>/login/generic_oauth
#   Web origins:        <GRAFANA_ROOT_URL>
#   Then under "Client scopes" make sure `openid`, `profile`, `email` are mapped.
#
# To map Keycloak roles to Grafana roles (Admin/Editor/Viewer), add a Mapper:
#   Type: User Client Role  (or Realm Role)
#   Token Claim Name: roles
#   Add to ID token: ON, Add to access token: ON, Add to userinfo: ON
#   Multivalued: ON
# Then assign Keycloak roles like `grafana-admin`, `grafana-editor` to users.

# === OIDC client credentials (REQUIRED when override is active) =============
#GRAFANA_OIDC_CLIENT_ID=grafana-loki-qa
#GRAFANA_OIDC_CLIENT_SECRET=<from Keycloak client credentials tab>

# === Keycloak endpoints (REQUIRED) ==========================================
# Replace <kc-host>, <realm>:
#GRAFANA_OIDC_AUTH_URL=https://<kc-host>/realms/<realm>/protocol/openid-connect/auth
#GRAFANA_OIDC_TOKEN_URL=https://<kc-host>/realms/<realm>/protocol/openid-connect/token
#GRAFANA_OIDC_USERINFO_URL=https://<kc-host>/realms/<realm>/protocol/openid-connect/userinfo

# === Public root URL of Grafana (REQUIRED for OAuth redirect) ===============
# Must match the redirect URI registered in the Keycloak client.
#GRAFANA_ROOT_URL=http://<host>:3300

# === Display ================================================================
# Button label and icon shown on Grafana's login page.
#GRAFANA_OIDC_NAME=Keycloak
#GRAFANA_OIDC_ICON=signin

# === Behavior ===============================================================
# Scopes requested from the provider. `openid` is mandatory.
#GRAFANA_OIDC_SCOPES=openid profile email

# Auto-create the user in Grafana on first login.
#GRAFANA_OIDC_ALLOW_SIGN_UP=true

# Skip the Grafana login page and bounce straight to Keycloak.
# Set true once you trust the integration. Local admin can still log in via
# /login (basic auth bypasses auto-login).
#GRAFANA_OIDC_AUTO_LOGIN=false

# JMESPath against the access/ID token to derive the Grafana role.
# Default expects Keycloak roles in a top-level `roles` claim (see mapper above):
#   grafana-admin  -> Admin
#   grafana-editor -> Editor
#   anything else  -> Viewer
#GRAFANA_OIDC_ROLE_ATTRIBUTE_PATH=contains(roles[*], 'grafana-admin') && 'Admin' || contains(roles[*], 'grafana-editor') && 'Editor' || 'Viewer'

# If true, users without a matching role in the path above are denied login.
# Default false = unmatched users get Viewer.
#GRAFANA_OIDC_ROLE_ATTRIBUTE_STRICT=false

# Whitelist email domains (comma-separated). Empty = any domain.
#GRAFANA_OIDC_ALLOWED_DOMAINS=

# Use PKCE (recommended on by default).
#GRAFANA_OIDC_USE_PKCE=true

# Refresh tokens to keep sessions alive (recommended on).
#GRAFANA_OIDC_USE_REFRESH_TOKEN=true

# Set true ONLY if Keycloak uses a self-signed cert and you can't fix it.
#GRAFANA_OIDC_TLS_SKIP_VERIFY=false

# Allow looking up existing Grafana users by email (useful when migrating from
# local accounts). Off by default for security.
#GRAFANA_OIDC_ALLOW_INSECURE_EMAIL_LOOKUP=false
