# =============================================================================
# Loki — Configuración por instancia
# =============================================================================
# Copiá este archivo como `.env` y descomentá SOLO las variables que querés
# sobreescribir. Los valores mostrados son los defaults que aplica el compose
# si la variable está comentada o ausente.
#
# Cada Loki que corras en el host debe tener su propio .env (idealmente en
# directorios distintos: loki-sistema-a/, loki-sistema-b/, etc).
# =============================================================================

# === Versión ================================================================
# Tag exacto de la imagen oficial de Loki. NO usar `latest` en producción.
# Ver: https://github.com/grafana/loki/releases
#LOKI_VERSION=3.7.1

# === Identificación de la instancia =========================================
# Nombre único del sistema. Se usa como sufijo del container_name y, por
# convención, como nombre del bucket en MinIO (si usás backend s3).
#LOKI_INSTANCE_NAME=default

# === Modo de despliegue =====================================================
# Selecciona qué servicios levanta `docker compose up`. Valores válidos:
# - monolithic: 1 contenedor con todos los componentes (recomendado).
# - scalable:   3 contenedores (read/write/backend). Requiere LOKI_STORAGE_BACKEND=s3.
# Var nativa de Docker Compose — no necesitás pasar --profile en CLI.
#COMPOSE_PROFILES=monolithic

# === Persistencia (host) ====================================================
# Directorio del HOST donde Loki persiste WAL, índice TSDB, working dir del
# compactor y, si LOKI_STORAGE_BACKEND=filesystem, también los chunks.
#LOKI_DATA_DIR=./data/loki

# === Recursos ===============================================================
# Reservas fijas en compose (no parametrizables): 0.25 CPU / 256M.
# Estos son los límites máximos.
#LOKI_CPU_LIMIT=1.0
#LOKI_MEMORY_LIMIT=1G

# === Red ====================================================================
# Puertos publicados al host. Cambialos si hay conflicto con otro Loki en el
# mismo servidor (sistema-a usa 3100, sistema-b usa 3101, etc).
#LOKI_HTTP_PORT=3100
#LOKI_GRPC_PORT=9095

# === Retención y límites de ingesta =========================================
#LOKI_RETENTION_PERIOD=2160h           # 90 días (3 meses)
#LOKI_INGESTION_RATE_MB=4              # MB/s por tenant
#LOKI_INGESTION_BURST_MB=6             # MB de burst permitido
#LOKI_MAX_QUERY_LENGTH=2161h           # un poco más que retention

# === Multi-tenant (X-Scope-OrgID) ===========================================
# - false: Loki acepta requests sin header. Todo va al tenant `fake`.
# - true:  Loki exige `X-Scope-OrgID` en cada request (Promtail/Alloy lo manda).
# NO es autenticación de red; para eso, usar reverse proxy con auth.
#LOKI_AUTH_ENABLED=false

# === Storage backend ========================================================
# - filesystem: chunks en LOKI_DATA_DIR. Sin deps externas. Single-node only.
# - s3:         chunks en MinIO/S3 externo. Requerido para modo scalable.
#LOKI_STORAGE_BACKEND=filesystem

# === MinIO / S3 (solo si LOKI_STORAGE_BACKEND=s3) ===========================
# El bucket debe existir antes de levantar Loki. Crear service account en
# MinIO console con policy de read/write sobre el bucket.

# Endpoint del MinIO. Usar https si va por reverse proxy con TLS.
#S3_ENDPOINT=

# Bucket dedicado de este sistema. Convención: loki-${LOKI_INSTANCE_NAME}.
#S3_BUCKET=

# Credenciales (service account de MinIO).
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# Region es obligatoria por el SDK de AWS aunque MinIO la ignore.
#S3_REGION=us-east-1

# Path-style URLs (bucket en el path, no en subdomain). MinIO lo requiere.
#S3_FORCE_PATH_STYLE=true

# true SOLO si S3_ENDPOINT es http:// (sin TLS). En prod siempre false.
#S3_INSECURE=false

# === Network compartida =====================================================
# Network externa (debe existir antes) donde Loki se adjunta para hablar con
# MinIO, Grafana u otros servicios. Crear con:
#   docker network create --driver bridge loki_router
# El MinIO debe estar también en esta red.
#LOKI_NETWORK=loki_router

# === Telemetría a Grafana Labs ==============================================
# false = no se envía nada de uso/diagnóstico a Grafana Labs.
#LOKI_ANALYTICS_REPORTING=false
